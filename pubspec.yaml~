name: zotoapp
description: A mini chat application with WebSocket and Riverpod
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  # State Management
  flutter_riverpod: ^2.4.9
  riverpod_annotation: ^2.3.3

  # WebSocket & Network
  web_socket_channel: ^2.4.0  # For WebSocket connection
  http: ^1.1.0                 # For REST API calls

  # Code Generation
  freezed_annotation: ^2.4.1
  json_annotation: ^4.8.1

  # UI & Utils
  intl: ^0.20.2                # For date formatting
  uuid: ^4.2.2                 # For generating unique IDs
  shared_preferences: ^2.2.2   # For local storage (user data, tokens)

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.1

  # Code Generation
  build_runner: ^2.4.7
  riverpod_generator: ^2.3.9
  freezed: ^2.4.6
  json_serializable: ^6.7.1